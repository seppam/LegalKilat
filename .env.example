# Semua variabel bersifat opsional untuk pengembangan lokal (aplikasi punya mode fallback).
# Salin menjadi .env dan JANGAN commit file .env.

PORT=3000
NODE_ENV=development

# MongoDB (opsional). Tanpa DB yang terjangkau, server memakai MemoryStore dan hanya login admin yang aktif.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legalkilat

# Wajib di produksi (server menolak start jika kosong saat NODE_ENV=production). Gunakan string acak panjang.
# Di non-produksi, bila kosong server membuat nilai acak dan mencetak sandi admin sekali di konsol.
SESSION_SECRET=ganti-dengan-string-acak
ADMIN_PASSWORD=ganti-dengan-sandi-kuat

# Token Hugging Face (opsional) untuk dense embedding. Tanpa token, RAG memakai pencarian kata kunci (sparse).
HF_TOKEN=
